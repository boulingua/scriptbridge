{
  "manifest_version": 3,
  "name": "Boulingua Scriptbridge",
  "version": "0.1.0",
  "description": "Practise unfamiliar letters while reading. Adjustable, reversible, and processed entirely on your device.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_popup": "popup.html", "default_title": "Practise letters with Boulingua"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
